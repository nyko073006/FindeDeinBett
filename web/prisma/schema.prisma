generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // Liegt im selben Verzeichnis wie dieses Schema. So ist die SQLite-Datei
  // Teil des Vercel-Deployments (web/ ist Vercel-Root) und der Python-Scraper
  // schreibt in dieselbe Datei.
  url      = "file:./database.sqlite"
}

model Bed {
  id       Int    @id @default(autoincrement())
  title    String
  shop     String
  price    Float
  currency String @default("EUR")
  url      String @unique
  imageUrl String?

  // Boxspring-spezifische Felder
  mattressType String? // z.B. Tonnentaschenfederkern, Bonellfederkern, Kaltschaum
  firmness     String? // Haertegrad, z.B. H2, H3, H4
  hasHeadboard Boolean @default(true) // false => "ohne Kopfteil"
  hasTopper    Boolean @default(false) // ist ueberhaupt ein Topper dabei?
  topperType   String? // konkreter Typ, falls bekannt: Visco, Kaltschaum, Gel ...
  width        Int? // cm
  length       Int? // cm
  color        String?

  inStock   Boolean  @default(true)
  scrapedAt DateTime @default(dbgenerated("CURRENT_TIMESTAMP"))

  @@index([price])
  @@index([firmness])
  @@index([mattressType])
}
